<Window x:Class="BessDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BESS Digital Twin Validation"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0d1117">
  <Grid>

    <!-- WebView fills the full window -->
    <wv2:WebView2 x:Name="WebView" />

    <!-- Loading splash shown until first navigation completes -->
    <Border x:Name="Splash" Background="#0d1117" Panel.ZIndex="10">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
        <TextBlock Text="BESS Digital Twin"
                   Foreground="#58a6ff"
                   FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   FontFamily="Segoe UI" />
        <TextBlock Text="Starting simulation server…"
                   Foreground="#8b949e"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   FontFamily="Segoe UI"
                   Margin="0,14,0,0" />
        <ProgressBar IsIndeterminate="True"
                     Height="3"
                     Margin="0,20,0,0"
                     Background="#21262d"
                     Foreground="#58a6ff"
                     BorderThickness="0" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
