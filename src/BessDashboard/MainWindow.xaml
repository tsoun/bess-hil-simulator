<Window x:Class="BessDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BESS Digital Twin Validation — Rener Energy"
        Width="1440" Height="900"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#07090f">
  <Grid>

    <!-- WebView fills the full window -->
    <wv2:WebView2 x:Name="WebView" />

    <!-- Loading splash shown until first navigation completes -->
    <Border x:Name="Splash" Background="#07090f" Panel.ZIndex="10">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
        <TextBlock Text="Rener Energy"
                   Foreground="#8098b4"
                   FontSize="11" FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   FontFamily="Segoe UI Variable, Segoe UI"
                   Margin="0,0,0,16" />
        <TextBlock Text="BESS Digital Twin"
                   Foreground="#cdd8ea"
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   FontFamily="Segoe UI Variable, Segoe UI" />
        <TextBlock Text="Starting simulation server…"
                   Foreground="#506278"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   FontFamily="Segoe UI Variable, Segoe UI"
                   Margin="0,10,0,0" />
        <ProgressBar IsIndeterminate="True"
                     Height="2"
                     Margin="0,22,0,0"
                     Background="#1a2640"
                     Foreground="#22d3ee"
                     BorderThickness="0" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
