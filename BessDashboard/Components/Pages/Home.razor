@page "/"
@using System.IO
@using System.Linq
@using System.Collections.Generic
@using BessHilSimulator

<PageTitle>BESS Digital Twin Validation Dashboard</PageTitle>

<style>
    /* Styling System for Premium Dark Mode Aesthetics */
    :root {
        --bg-color: #0d1117;
        --card-bg: rgba(22, 27, 34, 0.7);
        --card-border: rgba(48, 54, 61, 0.8);
        --text-color: #c9d1d9;
        --text-bright: #ffffff;
        --primary: #58a6ff;
        --success: #3fb950;
        --warning: #d29922;
        --danger: #f85149;
        --grid-line: rgba(56, 139, 253, 0.1);
        --glow: rgba(88, 166, 255, 0.15);
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-color);
        font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        margin: 0;
        padding: 0;
    }

    .dashboard-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 30px;
    }

    .header-panel {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        background: linear-gradient(135deg, rgba(22, 27, 34, 0.8) 0%, rgba(13, 17, 23, 0.9) 100%);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
    }

    .header-title h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        background: linear-gradient(90deg, #58a6ff, #bc8cff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .header-title p {
        margin: 5px 0 0 0;
        color: #8b949e;
        font-size: 14px;
    }

    .btn-action {
        background: linear-gradient(135deg, #1f6feb 0%, #0947a5 100%);
        border: none;
        color: white;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 0 10px rgba(31, 111, 235, 0.4);
    }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(31, 111, 235, 0.6);
    }

    .btn-secondary {
        background: #21262d;
        border: 1px solid var(--card-border);
        color: var(--text-color);
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        margin-right: 10px;
    }

    .btn-secondary:hover {
        background: #30363d;
    }

    /* Metric Card System */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .metric-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.25);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

    .metric-card::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
    }

    .metric-card.primary::after { background-color: var(--primary); }
    .metric-card.success::after { background-color: var(--success); }
    .metric-card.warning::after { background-color: var(--warning); }
    .metric-card.danger::after { background-color: var(--danger); }

    .metric-label {
        font-size: 13px;
        font-weight: 600;
        color: #8b949e;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .metric-value-container {
        display: flex;
        align-items: baseline;
        margin: 15px 0 5px 0;
    }

    .metric-value {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-bright);
    }

    .metric-unit {
        font-size: 14px;
        color: #8b949e;
        margin-left: 5px;
    }

    .metric-desc {
        font-size: 12px;
        color: #8b949e;
    }

    /* Progress bar */
    .coverage-progress-container {
        height: 6px;
        width: 100%;
        background-color: #30363d;
        border-radius: 3px;
        margin-top: 10px;
        overflow: hidden;
    }

    .coverage-progress-bar {
        height: 100%;
        border-radius: 3px;
        transition: width 0.5s ease-out;
    }

    /* Chart Cards */
    .chart-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 30px;
        box-shadow: 0 4px 30px rgba(0,0,0,0.3);
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--card-border);
    }

    .chart-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-bright);
    }

    .chart-legends {
        display: flex;
        gap: 15px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        font-size: 12px;
        color: #8b949e;
    }

    .legend-color {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        margin-right: 5px;
    }

    .svg-container {
        width: 100%;
        height: 320px;
        background-color: rgba(13, 17, 23, 0.5);
        border-radius: 8px;
        border: 1px solid rgba(48, 54, 61, 0.4);
    }

    /* Diagnostics & Saturation */
    .diagnosis-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
        gap: 30px;
        margin-bottom: 30px;
    }

    .diagnosis-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }

    .diagnosis-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--text-bright);
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .diag-item {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(48, 54, 61, 0.5);
    }

    .diag-item:last-child {
        border-bottom: none;
    }

    .diag-label {
        font-size: 14px;
        color: #c9d1d9;
    }

    .diag-value {
        font-weight: 600;
        font-size: 14px;
    }

    /* Tables */
    .table-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 25px rgba(0,0,0,0.25);
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .scroll-table-container {
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid rgba(48, 54, 61, 0.5);
        border-radius: 6px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    th, td {
        padding: 12px 16px;
        font-size: 13px;
        border-bottom: 1px solid rgba(48, 54, 61, 0.5);
    }

    th {
        background-color: #161b22;
        color: var(--text-bright);
        position: sticky;
        top: 0;
        z-index: 10;
        font-weight: 600;
    }

    tr:hover {
        background-color: rgba(56, 139, 253, 0.05);
    }

    /* Input paste popup area */
    .input-area {
        background: #161b22;
        border: 1px solid var(--card-border);
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 30px;
    }

    textarea {
        width: 100%;
        height: 120px;
        background: #0d1117;
        border: 1px solid var(--card-border);
        border-radius: 6px;
        color: var(--text-bright);
        font-family: monospace;
        padding: 10px;
        font-size: 12px;
        resize: vertical;
        margin-bottom: 10px;
    }
</style>

<div class="dashboard-container">
    
    <!-- Top Control Header -->
    <div class="header-panel">
        <div class="header-title">
            <h1>BESS Digital Twin Validation</h1>
            <p>Comparing active power setpoint (Pset) coverage against simulated physics and SCADA telemetry responses</p>
        </div>
        <div class="header-actions">
            @if (profileFileExists)
            {
                <button class="btn-secondary" @onclick="LoadAndSimulateDefault">Reset default profile</button>
            }
            <button class="btn-action" @onclick="ToggleInputArea">@(showInputArea ? "Hide Custom Input" : "Paste Custom CSV")</button>
        </div>
    </div>

    @if (showInputArea)
    {
        <div class="input-area">
            <h4>Paste Input CSV Profile</h4>
            <p style="font-size: 12px; color: #8b949e; margin-bottom: 10px;">
                Format: <code>Time_s,SetP_MW,SetQ_MVAR,GridV_pu,GridF_Hz</code> (one header line, followed by data rows).
            </p>
            <textarea @bind="customCsvText" placeholder="Time_s,SetP_MW,SetQ_MVAR,GridV_pu,GridF_Hz&#10;0.0,0.0,0.0,1.0,50.0&#10;1.0,0.1,0.0,1.0,50.0&#10;2.0,0.15,0.05,1.0,50.0"></textarea>
            <div>
                <button class="btn-action" @onclick="RunCustomSimulation">Run Simulation</button>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="color: var(--danger); font-size: 13px; margin-top: 10px;">@errorMessage</div>
            }
        </div>
    }

    <!-- Performance Metric Cards -->
    <div class="metrics-grid">
        <div class="metric-card @(coveragePercentage >= 95 ? "success" : (coveragePercentage >= 80 ? "warning" : "danger"))">
            <div>
                <div class="metric-label">Pset Coverage Score</div>
                <div class="metric-value-container">
                    <span class="metric-value">@coveragePercentage.ToString("F1")</span>
                    <span class="metric-unit">%</span>
                </div>
                <div class="metric-desc">Percentage of steps where physics covers Pset (tolerance ±0.005 MW)</div>
            </div>
            <div class="coverage-progress-container">
                <div class="coverage-progress-bar" 
                     style="width: @coveragePercentage.ToString("F0")%; background-color: @(coveragePercentage >= 95 ? "var(--success)" : (coveragePercentage >= 80 ? "var(--warning)" : "var(--danger)"))">
                </div>
            </div>
        </div>

        <div class="metric-card primary">
            <div>
                <div class="metric-label">Physics Error (MAE)</div>
                <div class="metric-value-container">
                    <span class="metric-value">@maePhys.ToString("F4")</span>
                    <span class="metric-unit">MW</span>
                </div>
                <div class="metric-desc">Mean Absolute Error between setpoint and inverter physics state</div>
            </div>
        </div>

        <div class="metric-card warning">
            <div>
                <div class="metric-label">SCADA Error (MAE)</div>
                <div class="metric-value-container">
                    <span class="metric-value">@maeMeas.ToString("F4")</span>
                    <span class="metric-unit">MW</span>
                </div>
                <div class="metric-desc">Mean Absolute Error at the SCADA terminal (includes 500ms delay)</div>
            </div>
        </div>

        <div class="metric-card primary">
            <div>
                <div class="metric-label">Simulation Metrics</div>
                <div class="metric-value-container">
                    <span class="metric-value">@((steps.Count * stepSizeSec / 60.0).ToString("F1"))</span>
                    <span class="metric-unit">mins</span>
                </div>
                <div class="metric-desc">@steps.Count data points parsed at Ts = @(stepSizeSec)s step interval</div>
            </div>
        </div>
    </div>

    @if (steps.Count > 0)
    {
        <!-- Main Plot: Active Power Coverage -->
        <div class="chart-card">
            <div class="chart-header">
                <div class="chart-title">Active Power Tracking Profile ($P_{set}$ vs $P_{phys}$ vs $P_{meas}$)</div>
                <div class="chart-legends">
                    <div class="legend-item">
                        <span class="legend-color" style="background-color: #58a6ff; border: 1px dashed white;"></span>
                        <span>Setpoint $P_{set}$</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-color" style="background-color: #3fb950;"></span>
                        <span>Physical $P_{phys}$</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-color" style="background-color: #d29922;"></span>
                        <span>SCADA Meas $P_{meas}$</span>
                    </div>
                </div>
            </div>
            
            <svg class="svg-container" viewBox="0 0 800 320">
                <!-- Grid Lines -->
                @for (int i = 1; i <= 5; i++)
                {
                    double yVal = minPower + (maxPower - minPower) * i / 6.0;
                    double yCoord = GetY(yVal, minPower, maxPower);
                    <line x1="60" y1="@yCoord" x2="780" y2="@yCoord" stroke="var(--grid-line)" stroke-width="1" />
                    @((MarkupString)$"<text x=\"50\" y=\"{yCoord + 4:F1}\" fill=\"#8b949e\" font-size=\"10\" text-anchor=\"end\">{yVal:F3}</text>")
                }
                
                <!-- Zero Line -->
                @if (minPower < 0 && maxPower > 0)
                {
                    double yZero = GetY(0, minPower, maxPower);
                    <line x1="60" y1="@yZero" x2="780" y2="@yZero" stroke="rgba(255,255,255,0.2)" stroke-width="1" />
                }

                <!-- Time Axis Labels -->
                @for (int i = 0; i <= 5; i++)
                {
                    double tVal = minTime + (maxTime - minTime) * i / 5.0;
                    double xCoord = GetX(tVal, minTime, maxTime);
                    <line x1="@xCoord" y1="20" x2="@xCoord" y2="275" stroke="var(--grid-line)" stroke-width="1" />
                    @((MarkupString)$"<text x=\"{xCoord:F1}\" y=\"295\" fill=\"#8b949e\" font-size=\"10\" text-anchor=\"middle\">{tVal / 60.0:F1} m</text>")
                }

                <!-- Plot Lines -->
                <path d="@GetPathPset()" fill="none" stroke="#58a6ff" stroke-width="2" stroke-dasharray="4,4" />
                <path d="@GetPathPphys()" fill="none" stroke="#3fb950" stroke-width="2.5" />
                <path d="@GetPathPmeas()" fill="none" stroke="#d29922" stroke-width="1.5" />

                <!-- Left Axis Label -->
                @((MarkupString)"<text x=\"15\" y=\"150\" fill=\"#8b949e\" font-size=\"11\" transform=\"rotate(-90 15 150)\" text-anchor=\"middle\">Power (MW)</text>")
                <!-- Bottom Axis Label -->
                @((MarkupString)"<text x=\"420\" y=\"315\" fill=\"#8b949e\" font-size=\"11\" text-anchor=\"middle\">Time (Minutes)</text>")
            </svg>
        </div>

        <!-- Diagnostic & Sub-charts Grid -->
        <div class="diagnosis-grid">
            
            <!-- Diagnostics Analysis Panel -->
            <div class="diagnosis-card">
                <div class="diagnosis-title">
                    <span style="color: var(--warning);">⚡</span> Coverage Derating & Limit Diagnostics
                </div>
                
                <div class="diag-item">
                    <span class="diag-label">Discharge Floor Restrictions (SOC &le; 5.0%)</span>
                    <span class="diag-value" style="color: @(socFloorSeconds > 0 ? "var(--danger)" : "var(--success)")">
                        @socFloorSeconds.ToString("F1") s
                    </span>
                </div>
                <div class="diag-item">
                    <span class="diag-label">Charge Ceiling Tapering (SOC &ge; 95.0%)</span>
                    <span class="diag-value" style="color: @(socCeilingSeconds > 0 ? "var(--warning)" : "var(--success)")">
                        @socCeilingSeconds.ToString("F1") s
                    </span>
                </div>
                <div class="diag-item">
                    <span class="diag-label">Apparent Power Saturation (S > Smax 0.21 MVA)</span>
                    <span class="diag-value" style="color: @(smaxSaturationSeconds > 0 ? "var(--danger)" : "var(--success)")">
                        @smaxSaturationSeconds.ToString("F1") s
                    </span>
                </div>
                <div class="diag-item">
                    <span class="diag-label">PQ Capability Curve Constraints</span>
                    <span class="diag-value" style="color: @(pqLimitSeconds > 0 ? "var(--warning)" : "var(--success)")">
                        @pqLimitSeconds.ToString("F1") s
                    </span>
                </div>
                <div style="margin-top: 15px; font-size: 13px; line-height: 1.5; color: #8b949e;">
                    <strong>Verification Details:</strong> 
                    @if (socFloorSeconds > 0)
                    {
                        <span>BESS active power coverage failed during low-battery cycles because discharging was fully blocked. </span>
                    }
                    @if (socCeilingSeconds > 0)
                    {
                        <span>BESS charging capability was restricted (tapered) because state-of-charge was approaching 100%. </span>
                    }
                    @if (smaxSaturationSeconds > 0)
                    {
                        <span>Apparent power exceeded limit, forcing the PCS to downscale active and reactive power components. </span>
                    }
                    @if (pqLimitSeconds > 0)
                    {
                        <span>Reactive power requests were clipped due to floating PQ curve limits (voltage-based clamping). </span>
                    }
                    @if (socFloorSeconds == 0 && socCeilingSeconds == 0 && smaxSaturationSeconds == 0 && pqLimitSeconds == 0)
                    {
                        <span>BESS was fully responsive to setpoints. Tracking discrepancies are purely due to First-Order Lag response parameters ($\tau_P=0.2$s) and transport delay.</span>
                    }
                </div>
            </div>

            <!-- Battery SOC Chart -->
            <div class="diagnosis-card">
                <div class="chart-header">
                    <div class="chart-title">Battery State of Charge (%)</div>
                    <div class="chart-legends">
                        <div class="legend-item">
                            <span class="legend-color" style="background-color: #bc8cff;"></span>
                            <span>SOC (%)</span>
                        </div>
                    </div>
                </div>
                <svg class="svg-container" viewBox="0 0 800 320" style="height: 200px;">
                    <!-- Grid Lines -->
                    <line x1="60" y1="20" x2="780" y2="20" stroke="var(--grid-line)" />
                    @((MarkupString)"<text x=\"50\" y=\"24\" fill=\"#8b949e\" font-size=\"10\" text-anchor=\"end\">100%</text>")
                    
                    <line x1="60" y1="95" x2="780" y2="95" stroke="rgba(210,153,34,0.3)" stroke-dasharray="3,3" /> <!-- Ceiling line -->
                    @((MarkupString)"<text x=\"50\" y=\"99\" fill=\"#d29922\" font-size=\"10\" text-anchor=\"end\">95%</text>")
                    
                    <line x1="60" y1="170" x2="780" y2="170" stroke="var(--grid-line)" />
                    @((MarkupString)"<text x=\"50\" y=\"174\" fill=\"#8b949e\" font-size=\"10\" text-anchor=\"end\">0%</text>")
                    
                    <line x1="60" y1="245" x2="780" y2="245" stroke="var(--grid-line)" />
                    
                    <!-- Plot Path -->
                    <path d="@GetPathSoc()" fill="none" stroke="#bc8cff" stroke-width="2.5" />
                </svg>
            </div>
            
        </div>

        <!-- Raw Step Data Table -->
        <div class="table-card">
            <div class="table-header">
                <h4 style="margin: 0; color: var(--text-bright);">Simulation Summary (First 150 points)</h4>
                <div style="font-size: 13px; color: #8b949e;">Scroll down to view detailed state tracking</div>
            </div>
            
            <div class="scroll-table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Time (s)</th>
                            <th>Cmd P (MW)</th>
                            <th>Phys P (MW)</th>
                            <th>Meas P (MW)</th>
                            <th>Cmd Q (MVAR)</th>
                            <th>Phys Q (MVAR)</th>
                            <th>Grid V (pu)</th>
                            <th>SOC (%)</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in steps.Take(150))
                        {
                            bool isCovered = Math.Abs(s.InputP - s.PhysP) <= 0.005;
                            <tr>
                                <td>@s.Time.ToString("F1")</td>
                                <td>@s.InputP.ToString("F3")</td>
                                <td>@s.PhysP.ToString("F3")</td>
                                <td>@s.MeasP.ToString("F3")</td>
                                <td>@s.InputQ.ToString("F3")</td>
                                <td>@s.PhysQ.ToString("F3")</td>
                                <td>@s.PhysV.ToString("F3")</td>
                                <td>@s.Soc.ToString("F2")</td>
                                <td style="color: @(isCovered ? "var(--success)" : "var(--danger)")">
                                    @(isCovered ? "✓ Covered" : "⚠️ Limited/Lag")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="chart-card" style="text-align: center; padding: 50px;">
            <h3>No simulation data available</h3>
            <p>Paste a custom CSV profile or restore the default workspace profile to load the validation interface.</p>
        </div>
    }

</div>

@code {
    public class DashboardStep
    {
        public double Time { get; set; }
        public double InputP { get; set; }
        public double InputQ { get; set; }
        public double SetpointP { get; set; }
        public double SetpointQ { get; set; }
        public double PhysP { get; set; }
        public double PhysQ { get; set; }
        public double PhysPF { get; set; }
        public double PhysV { get; set; }
        public double PhysF { get; set; }
        public double PhysI { get; set; }
        public double MeasP { get; set; }
        public double MeasQ { get; set; }
        public double MeasPF { get; set; }
        public double MeasV { get; set; }
        public double MeasF { get; set; }
        public double MeasI { get; set; }
        public double MaxQ { get; set; }
        public double MinQ { get; set; }
        public double Soc { get; set; }
        public double Soh { get; set; }
        public double Available { get; set; }
        public double TempCelsius { get; set; }
    }

    private List<DashboardStep> steps = new();
    private bool profileFileExists = false;
    private bool showInputArea = false;
    private string customCsvText = "";
    private string errorMessage = "";

    // Analysis metrics
    private double coveragePercentage = 0;
    private double maePhys = 0;
    private double rmsePhys = 0;
    private double maeMeas = 0;
    private double rmseMeas = 0;
    
    private double socFloorSeconds = 0;
    private double socCeilingSeconds = 0;
    private double smaxSaturationSeconds = 0;
    private double pqLimitSeconds = 0;

    // View boundaries for charts
    private double minTime = 0;
    private double maxTime = 100;
    private double minPower = -0.25;
    private double maxPower = 0.25;
    private double stepSizeSec = 1.0;

    protected override void OnInitialized()
    {
        // Check if default input file exists in the workspace
        var inputPath = GetFilePath("input_profile.csv");
        profileFileExists = File.Exists(inputPath);
        
        LoadAndSimulateDefault();
    }

    private void ToggleInputArea()
    {
        showInputArea = !showInputArea;
    }

    private string GetFilePath(string fileName)
    {
        if (File.Exists(fileName))
            return fileName;
        
        var parentPath = Path.Combine("..", fileName);
        if (File.Exists(parentPath))
            return parentPath;
            
        var dir = Directory.GetCurrentDirectory();
        while (dir != null)
        {
            var p = Path.Combine(dir, fileName);
            if (File.Exists(p)) return p;
            dir = Directory.GetParent(dir)?.FullName;
        }
        return fileName;
    }

    private void LoadAndSimulateDefault()
    {
        errorMessage = "";
        var inputPath = GetFilePath("input_profile.csv");
        if (!File.Exists(inputPath))
        {
            profileFileExists = false;
            return;
        }

        profileFileExists = true;
        try
        {
            var lines = File.ReadAllLines(inputPath);
            SimulateLines(lines);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error reading default file: {ex.Message}";
        }
    }

    private void RunCustomSimulation()
    {
        errorMessage = "";
        if (string.IsNullOrWhiteSpace(customCsvText))
        {
            errorMessage = "Please paste custom CSV data first.";
            return;
        }

        try
        {
            var lines = customCsvText.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            SimulateLines(lines);
            showInputArea = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Simulation failed: {ex.Message}";
        }
    }

    private void SimulateLines(string[] lines)
    {
        if (lines.Length <= 1)
        {
            throw new Exception("CSV contains no data rows.");
        }

        // Identify header positions
        int timeIdx = -1, pIdx = -1, qIdx = -1, vIdx = -1, fIdx = -1;
        string[] headers = lines[0].Split(',');
        for (int i = 0; i < headers.Length; i++)
        {
            string h = headers[i].Trim().ToLower();
            if (h.StartsWith("time")) timeIdx = i;
            else if (h.Contains("setp") || h.Contains("active")) pIdx = i;
            else if (h.Contains("setq") || h.Contains("reactive")) qIdx = i;
            else if (h.Contains("gridv") || h.Contains("voltage")) vIdx = i;
            else if (h.Contains("gridf") || h.Contains("frequency")) fIdx = i;
        }

        if (timeIdx == -1) timeIdx = 0;
        if (pIdx == -1) pIdx = 1;
        if (qIdx == -1) qIdx = 2;
        if (vIdx == -1) vIdx = 3;
        if (fIdx == -1) fIdx = 4;

        var inputRows = new List<InputRow>();
        for (int i = 1; i < lines.Length; i++)
        {
            string line = lines[i].Trim();
            if (string.IsNullOrEmpty(line)) continue;
            
            string[] parts = line.Split(',');
            if (parts.Length <= Math.Max(timeIdx, Math.Max(pIdx, qIdx))) continue;

            var row = new InputRow();
            row.Time = double.Parse(parts[timeIdx]);
            row.SetpointP = double.Parse(parts[pIdx]);
            row.SetpointQ = double.Parse(parts[qIdx]);
            
            if (vIdx < parts.Length && double.TryParse(parts[vIdx], out double v)) row.GridV = v;
            if (fIdx < parts.Length && double.TryParse(parts[fIdx], out double f)) row.GridF = f;
            
            inputRows.Add(row);
        }

        if (inputRows.Count == 0)
        {
            throw new Exception("Could not parse any valid rows from CSV input.");
        }

        // Determine Ts
        double Ts = 0.1;
        if (inputRows.Count > 1)
        {
            Ts = inputRows[1].Time - inputRows[0].Time;
            if (Ts <= 0) Ts = 0.1;
        }
        stepSizeSec = Ts;

        // Initialize Physics Model
        double Tdelay = 0.5; // SCADA Delay (seconds)
        var plant = new BessPhysicsModel(Ts, 0.2, 0.1, Tdelay, 0.21);

        var outputSteps = new List<DashboardStep>();
        foreach (var row in inputRows)
        {
            var y = plant.Step(row.SetpointP, row.SetpointQ, row.GridV, row.GridF, row.Time);
            
            var step = new DashboardStep
            {
                Time = row.Time,
                InputP = row.SetpointP,
                InputQ = row.SetpointQ,
                SetpointP = y.SetpointP,
                SetpointQ = y.SetpointQ,
                PhysP = y.PhysP,
                PhysQ = y.PhysQ,
                PhysPF = y.PhysPF,
                PhysV = y.PhysV,
                PhysF = y.PhysF,
                PhysI = y.PhysI,
                MeasP = y.MeasP,
                MeasQ = y.MeasQ,
                MeasPF = y.MeasPF,
                MeasV = y.MeasV,
                MeasF = y.MeasF,
                MeasI = y.MeasI,
                MaxQ = y.MaxQ,
                MinQ = y.MinQ,
                Soc = y.Soc,
                Soh = y.Soh,
                Available = y.Available,
                TempCelsius = y.TempCelsius
            };
            outputSteps.Add(step);
        }

        steps = outputSteps;

        // Chart View Borders
        minTime = steps.Min(s => s.Time);
        maxTime = steps.Max(s => s.Time);
        
        double minP = steps.Min(s => Math.Min(s.InputP, Math.Min(s.PhysP, s.MeasP)));
        double maxP = steps.Max(s => Math.Max(s.InputP, Math.Max(s.PhysP, s.MeasP)));
        double pad = Math.Max(0.02, (maxP - minP) * 0.1);
        minPower = minP - pad;
        maxPower = maxP + pad;

        RunAnalysis();
    }

    private void RunAnalysis()
    {
        if (steps.Count == 0) return;

        double sumPError = 0;
        double sumPErrorSq = 0;
        double sumPMeasError = 0;
        double sumPMeasErrorSq = 0;
        int coveredSteps = 0;
        
        socFloorSeconds = 0;
        socCeilingSeconds = 0;
        smaxSaturationSeconds = 0;
        pqLimitSeconds = 0;

        foreach (var s in steps)
        {
            double errPhys = Math.Abs(s.InputP - s.PhysP);
            double errMeas = Math.Abs(s.InputP - s.MeasP);

            sumPError += errPhys;
            sumPErrorSq += errPhys * errPhys;
            sumPMeasError += errMeas;
            sumPMeasErrorSq += errMeas * errMeas;

            // Covered within tight margin
            if (errPhys <= 0.005)
            {
                coveredSteps++;
            }

            // Clamping Analysis
            // 1. SOC floor limit active (discharge Command positive, but setpoint clamped to 0)
            if (s.InputP > 0.0 && s.SetpointP <= 0.0001 && s.Soc <= 5.05)
            {
                socFloorSeconds += stepSizeSec;
            }
            // 2. SOC ceiling charge limit (charge command negative, but setpoint P restricted relative to input)
            if (s.InputP < 0.0 && Math.Abs(s.SetpointP) < Math.Abs(s.InputP) && s.Soc >= 94.95)
            {
                socCeilingSeconds += stepSizeSec;
            }
            // 3. Smax Saturation
            double rawS = Math.Sqrt(s.InputP * s.InputP + s.InputQ * s.InputQ);
            if (rawS > 0.2105 && Math.Sqrt(s.SetpointP * s.SetpointP + s.SetpointQ * s.SetpointQ) <= 0.2105)
            {
                smaxSaturationSeconds += stepSizeSec;
            }
            // 4. PQ capability limits (Reactive power setpoint clamped relative to requested input Q)
            if (Math.Abs(s.InputQ - s.SetpointQ) > 0.001)
            {
                pqLimitSeconds += stepSizeSec;
            }
        }

        coveragePercentage = (double)coveredSteps / steps.Count * 100.0;
        maePhys = sumPError / steps.Count;
        rmsePhys = Math.Sqrt(sumPErrorSq / steps.Count);
        maeMeas = sumPMeasError / steps.Count;
        rmseMeas = Math.Sqrt(sumPMeasErrorSq / steps.Count);
    }

    // Coordinate Mappers
    private double GetX(double time, double minT, double maxT)
    {
        double width = 800;
        double paddingLeft = 60;
        double paddingRight = 20;
        if (maxT == minT) return paddingLeft;
        return paddingLeft + (width - paddingLeft - paddingRight) * (time - minT) / (maxT - minT);
    }

    private double GetY(double val, double minV, double maxV)
    {
        double height = 275;
        double paddingTop = 20;
        double paddingBottom = 45;
        if (maxV == minV) return height - paddingBottom - (height - paddingTop - paddingBottom) / 2;
        return height - paddingBottom - (height - paddingTop - paddingBottom) * (val - minV) / (maxV - minV);
    }

    // Path Builders
    private string GetPathPset()
    {
        if (steps.Count == 0) return "";
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < steps.Count; i++)
        {
            var s = steps[i];
            double x = GetX(s.Time, minTime, maxTime);
            double y = GetY(s.InputP, minPower, maxPower);
            if (i == 0) sb.Append($"M {x:F1} {y:F1}");
            else sb.Append($" L {x:F1} {y:F1}");
        }
        return sb.ToString();
    }

